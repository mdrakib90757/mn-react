# Server Configuration
PORT=8080

# Deepgram Speech-To-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DG_MODEL=nova-3
DG_LANGUAGE=bn
DG_SAMPLE_RATE=16000
DG_ENCODING=linear16

# LLM Analysis Configuration
# Supported providers: gemini (default), openai, or openai-compatible (groq, openrouter, ollama)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional: custom base URL for OpenAI-compatible providers (e.g. Groq, Local Ollama)
# LLM_BASE_URL=https://api.groq.com/openai/v1
